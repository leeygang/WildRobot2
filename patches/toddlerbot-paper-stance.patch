@@ -0,0 +1,682 @@
+"""Paired nominal stance controls for the saved ToddlerBot Paper policy."""
+
+import os
+
+os.environ["USE_JAX"] = "true"
+os.environ.setdefault("XLA_PYTHON_CLIENT_PREALLOCATE", "false")
+os.environ["XLA_FLAGS"] = "--xla_gpu_triton_gemm_any=true"
+
+import argparse
+import copy
+import hashlib
+import importlib.metadata as metadata
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+import jax
+import jax.numpy as jnp
+import mujoco
+import numpy as np
+from brax.io import model as brax_model
+from brax.training.agents.ppo import networks
+from mujoco.mjx._src import support
+
+from toddlerbot.locomotion.evaluate_xy import CONDITIONS
+from toddlerbot.locomotion.mjx_config import MJXConfig
+from toddlerbot.locomotion.walk_env import WalkEnv
+from toddlerbot.sim.robot import Robot
+from toddlerbot.utils.math_utils import quat_inv, rotate_vec
+
+jax.config.update("jax_default_matmul_precision", "high")
+
+PAPER_REVISION = "a4f693d7cc4544f011dad23d6c353e752a6819ab"
+BRAX_REVISION = "14147806f6c25724ba830ba36764df3243889b0d"
+PAIR_NAMES = (
+    ("ank_roll_link_collision", "ank_roll_link_2_collision"),
+    ("left_ank_pitch_link_collision", "right_ank_pitch_link_collision"),
+)
+CONTROLS = ("learned", "hip_roll_reference", "leg_reference")
+
+
+def reference_action(action, reference, home, scale, mask):
+    requested = jnp.clip((reference - home) / scale, -1.0, 1.0)
+    return jnp.where(mask, requested, action)
+
+
+def target_trace(env, state, action, reference):
+    """Reconstruct the native delayed, bounded motor-position requests."""
+    buffer = jnp.roll(state.info["action_buffer"], env.num_action)
+    delayed = buffer.at[: env.num_action].set(action)[-env.num_action :]
+    request = state.info["default_action"] + env.action_scale * delayed
+    target = reference[env.ref_start_idx : env.ref_start_idx + env.nu]
+    target = target.at[env.action_mask].set(request)
+    delivered = jnp.clip(target, env.motor_limits[:, 0], env.motor_limits[:, 1])
+    return request, delivered
+
+
+class StanceEnv(WalkEnv):
+    """Diagnostic instrumentation around the unchanged native controller."""
+
+    def reset(self, rng, command=None):
+        state = super().reset(rng, command)
+        info = dict(state.info)
+        # Native reset always samples yaw, even with domain randomization off.
+        # Rebuild its reference-based pose at zero yaw for the WR2 comparison.
+        info["state_ref"] = (
+            info["state_ref"].at[3:7].set(jnp.array([1.0, 0.0, 0.0, 0.0]))
+        )
+        qpos = self.motion_ref.get_qpos_ref(info["state_ref"], path_frame=False)
+        pipeline = self.pipeline_init(qpos, jnp.zeros(self.nv))
+        info["feet_height_init"] = pipeline.x.pos[self.feet_link_ids, 2]
+        info["diagnostic_delivered_target"] = jnp.zeros(self.nu)
+        obs, privileged = self._get_obs(
+            pipeline,
+            info,
+            jnp.zeros_like(state.obs),
+            jnp.zeros_like(state.privileged_obs),
+        )
+        return state.replace(
+            pipeline_state=pipeline,
+            info=info,
+            obs=obs,
+            privileged_obs=privileged,
+        )
+
+    def pipeline_step(self, state, action):
+        # This argument is the bounded POSITION target. pipeline.ctrl contains
+        # motor torque and must not be mistaken for a delivered position target.
+        state.info["diagnostic_delivered_target"] = action
+        return super().pipeline_step(state, action)
+
+
+def signed_foot_distances(model, pairs, centers, rotations, valid):
+    """Distances at the traced solver geometry instant, preserving padding."""
+    # MuJoCo 3.2.4's legacy box collision routine reports half the penetration
+    # depth. Use native CCD for offline distance, matching WR2's distance API.
+    # Its exact-touch degeneracy needs a zero-distance check with the legacy
+    # routine. Neither changes the simulation model or its MJX collisions.
+    geometry_model = copy.copy(model)
+    geometry_model.opt.enableflags |= int(mujoco.mjtEnableBit.mjENBL_NATIVECCD)
+    data = mujoco.MjData(geometry_model)
+    result = np.zeros((len(valid), len(pairs)))
+    for index in np.flatnonzero(valid):
+        for pair_index, pair in enumerate(pairs):
+            data.geom_xpos[pair] = centers[index, pair_index]
+            data.geom_xmat[pair] = rotations[index, pair_index].reshape(2, 9)
+            legacy = mujoco.mj_geomDistance(model, data, *pair, 1.0, None)
+            result[index, pair_index] = (
+                0.0
+                if legacy == 0.0
+                else mujoco.mj_geomDistance(
+                    geometry_model,
+                    data,
+                    *pair,
+                    1.0,
+                    None,
+                )
+            )
+    return result
+
+
+def summarize_stance(trace, names, dt):
+    valid = trace["valid"].astype(bool)
+    count = int(valid.sum())
+
+    def mean(value):
+        return float(np.mean(value[valid])) if count else None
+
+    def rms(value):
+        return float(np.sqrt(np.mean(value[valid] ** 2))) if count else None
+
+    actual_double = trace["contact"].all(axis=1)
+    requested_double = trace["reference_contact"].all(axis=1) & valid
+    error = np.linalg.norm(trace["velocity_m_s"] - trace["command_m_s"][:, :2], axis=1)
+    return {
+        "sample_count": count,
+        "duration_physical_s": count * dt,
+        "duration_TB_equivalent_s": count * dt,
+        "fell": bool(trace["fall_event"].any()),
+        "nonfinite": bool(trace["nonfinite_event"].any()),
+        "velocity_TB_equivalent_m_s": [
+            mean(trace["velocity_m_s"][:, j]) for j in range(2)
+        ],
+        "velocity_std_TB_equivalent_m_s": [
+            float(np.std(trace["velocity_m_s"][valid, j])) if count else None
+            for j in range(2)
+        ],
+        "translation_TB_equivalent_m": trace["path_delta_m"][valid]
+        .sum(axis=0)
+        .tolist(),
+        "net_velocity_TB_equivalent_m_s": [
+            mean(trace["path_delta_m"][:, j] / dt) for j in range(2)
+        ],
+        "xy_error_TB_equivalent_m_s": mean(error),
+        "single_support_fraction": mean(np.logical_xor(*trace["contact"].T)),
+        "double_support_fraction": mean(actual_double),
+        "no_support_fraction": mean(~trace["contact"].any(axis=1)),
+        "reference_double_support_sample_count": int(requested_double.sum()),
+        "reference_double_support_match_fraction": (
+            float(actual_double[requested_double].mean())
+            if requested_double.any()
+            else None
+        ),
+        "exact_contact_match_fraction": mean(
+            (trace["contact"] == trace["reference_contact"]).all(axis=1)
+        ),
+        "foot_self_contact_fraction": mean(
+            trace["foot_self_force_n"].max(axis=1) > 0.1
+        ),
+        "foot_gap_min_m": float(trace["foot_gap_m"][valid].min()) if count else None,
